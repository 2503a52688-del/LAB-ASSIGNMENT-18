PROMPT:

Create a simple Python GitHub Repository Info Fetcher using the requests library and GitHub API.

Requirements:
1. Ask the user to enter a GitHub username and repository name.
2. Fetch repository details using a GET request to the GitHub API.
3. Display repository name, description, stars, forks, and open issues.
4. Handle errors such as repository not found (404), API rate limit exceeded, invalid input, and network errors.
5. Display the results in a clear and readable format.
6. Use simple Python code with comments.

CODE;

"""Fetch and display public GitHub repository information."""

import json
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import Request, urlopen


def main():
    username = input("Enter the GitHub username: ").strip()
    repository = input("Enter the repository name: ").strip()

    if not username or not repository or "/" in username or "/" in repository:
        print("Invalid input. Enter a username and repository name without slashes.")
        return

    url = (
        "https://api.github.com/repos/"
        f"{quote(username, safe='')}/{quote(repository, safe='')}"
    )
    request = Request(
        url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "repo-info-fetcher",
        },
    )

    try:
        with urlopen(request, timeout=10) as response:
            data = json.load(response)
    except HTTPError as error:
        if error.code == 404:
            print("Repository not found. Check the username and repository name.")
        elif error.code in (403, 429):
            if error.headers.get("X-RateLimit-Remaining") == "0" or error.code == 429:
                print("GitHub API rate limit exceeded. Please try again later.")
            else:
                print("GitHub denied access to this request. Please try again later.")
        else:
            print(f"GitHub API returned an error (HTTP {error.code}).")
        return
    except (TimeoutError, URLError) as error:
        print(f"Network error while contacting GitHub: {error}")
        return
    except json.JSONDecodeError:
        print("GitHub returned an invalid response.")
        return

    if not isinstance(data, dict):
        print("GitHub returned an invalid response.")
        return

    print("\nRepository Information")
    print("----------------------")
    print(f"Name:        {data.get('full_name', data.get('name', 'N/A'))}")
    print(f"Description: {data.get('description') or 'No description'}")
    print(f"Stars:       {data.get('stargazers_count', 'N/A')}")
    print(f"Forks:       {data.get('forks_count', 'N/A')}")
    print(f"Open issues: {data.get('open_issues_count', 'N/A')}")


if __name__ == "__main__":
    main()

