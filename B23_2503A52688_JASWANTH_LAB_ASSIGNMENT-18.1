Task 4 – Real-Time Application: News Headlines Aggregator
Scenario: Build a News Aggregator using a free News API.
Requirements:
 Fetch top 5 headlines for a given category (sports, technology,
health).
 Handle errors like invalid category, missing API key, and request
failures.
 Display headlines in a user-friendly numbered list format.

 Include a retry mechanism if the first request fails.
Expected Output:
 A working Python script that retrieves and displays news
headlines with proper error handling

PROMPT:

Create a simple Python News Aggregator using the requests library and News API. Ask the user to select sports, technology, or health. Fetch and display the top 5 headlines in a numbered list. Handle invalid categories, missing API keys, and network errors. Add a retry mechanism if the request fails. Save the code as news.py with simple comments.

CODE:

import getpass
import json
import os
import time
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import urlopen


API_URL = "https://newsapi.org/v2/top-headlines"
CATEGORIES = {"sports", "technology", "health"}


def get_headlines(category, api_key, retries=3):
    params = urlencode(
        {
            "country": "us",
            "category": category,
            "apiKey": api_key,
            "pageSize": 5,
        }
    )
    url = f"{API_URL}?{params}"

    for attempt in range(retries):
        try:
            with urlopen(url, timeout=10) as response:
                data = json.load(response)

            if not isinstance(data, dict) or data.get("status") != "ok":
                message = data.get("message", "News API returned an unsuccessful response.")
                raise ValueError(message)

            articles = data.get("articles")
            if not isinstance(articles, list):
                raise ValueError("News API returned an invalid articles list.")
            return articles
        except HTTPError as error:
            try:
                details = json.load(error)
                message = details.get("message", str(error))
            except (json.JSONDecodeError, AttributeError):
                message = str(error)
            raise RuntimeError(f"News API request failed: {message}") from error
        except (TimeoutError, URLError) as error:
            if attempt == retries - 1:
                raise RuntimeError(f"Network error while contacting News API: {error}") from error
            print(f"Request failed; retrying ({attempt + 1}/{retries - 1})...")
            time.sleep(1)
        except json.JSONDecodeError as error:
            raise RuntimeError("News API returned an invalid JSON response.") from error


def main():
    api_key = os.getenv("NEWS_API_KEY", "").strip()
    if not api_key:
        api_key = getpass.getpass("Enter your NewsAPI key: ").strip()
    if not api_key:
        print("A NewsAPI key is required.")
        return

    category = input("Choose a category (sports, technology, or health): ").strip().lower()
    if category not in CATEGORIES:
        print("Invalid category. Please choose sports, technology, or health.")
        return

    try:
        articles = get_headlines(category, api_key)
    except RuntimeError as error:
        print(f"Unable to fetch headlines: {error}")
        return

    if not articles:
        print("No headlines found.")
        return

    for number, article in enumerate(articles[:5], start=1):
        title = article.get("title") if isinstance(article, dict) else None
        print(f"{number}. {title or 'Untitled'}")


if __name__ == "__main__":
    main()


