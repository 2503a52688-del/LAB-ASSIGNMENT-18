PROMPT:

Create a simple Python Currency Converter program using the requests library and a Currency Exchange API.

Requirements:
1. Ask the user to enter an amount in INR.
2. Fetch the latest exchange rates using a Currency Exchange API.
3. Convert INR into USD, EUR, and GBP.
4. Validate the amount (it must be a positive number).
5. Handle invalid input, API errors, invalid responses, and network failures.
6. Display the conversion results in a clear table format.
7. Use simple Python code with comments.

.


CODE;

import json
from decimal import Decimal, InvalidOperation
from urllib.error import HTTPError, URLError
from urllib.request import urlopen


API_URL = "https://open.er-api.com/v6/latest/INR"


def main():
	# Read and validate the amount entered by the user.
	try:
		amount = Decimal(input("Enter amount in INR: ").strip())
		if not amount.is_finite() or amount <= 0:
			raise ValueError
	except (InvalidOperation, ValueError):
		print("Invalid amount. Enter a positive number.")
		return

	# Fetch the latest exchange rates for INR.
	try:
		with urlopen(API_URL, timeout=10) as response:
			data = json.load(response)

		if not isinstance(data, dict) or data.get("result") != "success":
			raise ValueError("The API returned an unsuccessful or invalid response.")
		rates = data.get("rates")
		if not isinstance(rates, dict):
			raise ValueError("The API response does not contain exchange rates.")

		conversions = {}
		for currency in ("USD", "EUR", "GBP"):
			rate = Decimal(str(rates[currency]))
			if not rate.is_finite() or rate <= 0:
				raise ValueError(f"Invalid exchange rate for {currency}.")
			conversions[currency] = amount * rate

	except HTTPError as error:
		print(f"Exchange-rate service error (HTTP {error.code}).")
		return
	except (TimeoutError, URLError) as error:
		print(f"Network or API request error: {error}")
		return
	except json.JSONDecodeError:
		print("The exchange-rate service returned an invalid response.")
		return
	except (ValueError, KeyError, TypeError, InvalidOperation) as error:
		print(f"Could not process the exchange-rate response: {error}")
		return

	# Show the converted amounts in a simple table.
	print("\nCurrency conversion (latest rates)")
	print("+----------+----------------+")
	print("| Currency | Converted      |")
	print("+----------+----------------+")
	for currency, converted in conversions.items():
		print(f"| {currency:<8} | {converted:>14.2f} |")
	print("+----------+----------------+")


if __name__ == "__main__":
	main()


